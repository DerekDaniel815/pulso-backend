POSTGRES_DB=pulso_db
POSTGRES_USER=pulso
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://pulso:CHANGE_ME@localhost:5432/pulso_db
# Opcional en cloud: conexión directa usada exclusivamente por Prisma Migrate.
DIRECT_URL=

JWT_SECRET=
JWT_EXPIRES_IN=7d

# Lista separada por comas. Las apps React Native nativas no envian Origin.
CORS_ORIGIN=http://localhost:8081

ENABLE_DEVICE_SIMULATION=false
SIMULATION_LEASE_SECONDS=45
SIMULATION_EXPIRE_INTERVAL_MS=10000
